class Solution {
public:
    int search(vector<int>& nums, int target) {
        int n= nums.size();
        int low=0,high = n-1;
        while(low<=high){
            int mid= (low+high)/2;
            if(nums[mid]== target) return mid;

            //checking left sorted or not 

            if(nums[low]<=nums[mid]){
                 
                 //checking wether it contains the target element or not
                 if(nums[low]<=target && target <= nums[mid]) 
                 high = mid-1;

                 else
                 low = mid+1;


            }
            //other condn will be of right sorted 
            else{
                
                // checking wehter it contains or not
                if(nums[mid]<=target && target <= nums[high])
                low = mid+1;

                else
                high = mid-1;
            }
        }
        return -1;
    }
};
