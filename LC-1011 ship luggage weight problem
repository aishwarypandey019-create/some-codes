class Solution {
public:
int totday(vector<int> &weights, int mid){
    int noofday =1;
    int load =0;
    for(int i=0;i<weights.size();i++){
        if(weights[i]+load > mid){
            noofday++;
            load = weights[i];
        }
        else
        load += weights[i];
    }
    return noofday;
}
    int shipWithinDays(vector<int>& weights, int days) {
        int  low = *max_element(weights.begin(),weights.end());
        int high = accumulate(weights.begin(),weights.end(),0);
        while(low<=high){
            int mid = (low+high)/2;
            int totalday = totday(weights,mid);
            if(totalday <= days){
                high = mid-1;
            }
            else
            low = mid+1;
        }
        return low;
    
    }
};
