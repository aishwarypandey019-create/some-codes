
class Solution {
public:
void combopermute(vector<int> freq,vector<int>&ds,vector<int>&nums,vector<vector<int>>&ans){
             if(ds.size() == nums.size()){
                ans.push_back(ds);
                return;
             }
             for(int i=0;i<nums.size();i++){
                if(!freq[i]){
                    ds.push_back(nums[i]);
                    freq[i] = 1;
                    combopermute(freq,ds,nums,ans);
                    ds.pop_back();
                    freq[i] = 0;
                }
             }
}
    vector<vector<int>> permute(vector<int>& nums) {
        vector<vector<int>> ans;
        vector<int> ds;
        vector<int> freq(nums.size(),0);
        combopermute(freq,ds,nums,ans);
        return ans;
    }
};
