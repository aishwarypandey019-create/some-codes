class Solution {
public:
int number(vector<int> &nums, int mid){
    int count = 1;
    long long sum =0;
    for(int i=0;i<nums.size();i++){
        if(sum + nums[i] <= mid){
            sum += nums[i];
        }
        else{
            count++;
            sum = nums[i];
        }
    }
    return count;
}
    int splitArray(vector<int>& nums, int k) {
        int low = *max_element(nums.begin(),nums.end());
        int high = accumulate(nums.begin(),nums.end(),0);
        int n = nums.size();
        if(k>n)return -1;
        while(low<=high){
            int mid = (low+high)/2;
            int count = number(nums,mid);
            if(count <=k){
                high = mid-1;
            }
            else{
                low = mid+1;
            }
        }
        return low;
    }
};
