class Solution {
public:
    bool isAnagram(string s, string t) {
        if(s.size()!= t.size()) return false;

        vector<int> counting(26,0);

        for(int i=0;i<s.size();i++){
            counting[s[i]-'a']++;
            counting[t[i]-'a']--;
        }
        for(int i=0;i<26;i++){
            if(counting[i] != 0) return false;
        }
        return true;
    }
};
