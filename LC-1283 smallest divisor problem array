class Solution {
public:
   int finding(vector<int>&nums, int num){
    int cnt=0;
    for(int i=0;i<nums.size();i++){
        
       cnt += (nums[i] + num - 1) / num;
    }
    return cnt;
   }
    int smallestDivisor(vector<int>& nums, int threshold) {
        int mini = INT_MAX;
        int maxi= INT_MIN;
        int finalans = INT_MAX;
       
        int n = nums.size();
         for(int i=0;i<n;i++){
            mini= min(nums[i],mini);
            maxi = max(nums[i],maxi);
         }
            int low = 1;
            int high = maxi;
            while(low<=high){
                   int mid = (low+high)/2;
                   int sumdivisor = finding(nums,mid);
                   if(sumdivisor<= threshold){
                    finalans= min(finalans,mid);
                   high = mid-1;
                   }
                   else
                   low=mid+1;

            }
        return finalans;
    }
};
