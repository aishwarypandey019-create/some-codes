class Solution {
public:
    bool searchMatrix(vector<vector<int>>& matrix, int target) {
        int m = matrix.size();
        int n = matrix[0].size();
        if(m==1 && n ==1){
            if(matrix[0][0] == target) return true;
            else false;
        }
        for(int i=0;i<m;i++){
            int low=0, high = n-1;
            while(low<=high){
                int mid = low + (high - low) / 2;     
                if(matrix[i][mid]== target) return true;
                else if(matrix[i][mid]> target) high = mid-1;
                else low = mid+1;   
            } 
        }
        return false;
    }
};
