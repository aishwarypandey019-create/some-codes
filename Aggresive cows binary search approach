#include<bits/stdc++.h>
using namespace std;
bool possible(vector<int> &stalls , int mid , int cows){
    int cntcow=1,currentcow = stalls[0];
    int n = stalls.size();
    for(int i =0;i<n;i++){
        if(stalls[i] - currentcow >= mid){
            cntcow++;
            currentcow = stalls[i];
        }
    }
    if(cntcow>= cows)return true;
    else return false;
}
int aggresivecows(vector<int> &stalls,int cows){
    int n = stalls.size();
    sort(stalls.begin(),stalls.end());
    int low = 0, high = stalls[n-1];
   while(low<=high){
    int mid = (low+high)/2;
    if(possible(stalls, mid, cows) == true) low=mid+1;
    else high = mid-1;
   }
   return high;
}
int main(){
    vector<int> arr = {3,5,2,8,10,13};
    cout<< aggresivecows(arr,4);
}
